{% set isEdit = isEdit|default(false) %}
{% set hasTax = taxRatesConfigured() %}
{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}
    {% if quote is defined %}
        {{ 'quote.title'|trans({'%id%' : quote.quoteId}) }}
    {% else %}
        {{ 'quote.create'|trans }}
    {% endif %}
{% endblock %}

{% block content %}
    {% set currency = quote.client.currency|default(null) %}

    {{ form_start(form, {'attr': {'id': 'quote-form'}}) }}
    
    <!-- Compact Client Form at top -->
    <twig:CompactClientForm />
    
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <section class="invoice">

                        <div class="col-12">
                            <div class="row">
                                <div class="col-6" 
                                     data-controller="client-details" 
                                     data-client-details-api-token-value="569a168393da35304d9f2a2e0e3fa4305db7efcd9e8e3d36d6b9ca1a9d8c6269"
                                     data-client-details-api-url-value="http://localhost:3000">
                                    <div id="client-selection-section">
                                        {{ form_row(form.client, {attr: {'class': 'client-select'}}) }}
                                        <div class="mt-2">
                                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="toggleCompactClientForm(event)">
                                                {{ icon('plus') }} {{ 'Add New Client'|trans }}
                                            </button>
                                        </div>
                                    </div>
                                    
                                    <div data-client-details-target="details" class="mt-3 p-3 bg-light border rounded" style="display: none;">
                                        <div class="row">
                                            <div class="col-md-8">
                                                <h5 data-client-details-target="clientName">Client Name</h5>
                                                <div data-client-details-target="contact">
                                                    <!-- Contact details will be populated by controller -->
                                                </div>
                                                <div data-client-details-target="address">
                                                    <!-- Address details will be populated by controller -->
                                                </div>
                                            </div>
                                            <div class="col-md-4 text-right">
                                                <a href="#" class="btn btn-sm btn-outline-secondary" data-action="click->client-details#clearClient">
                                                    {{ "change"|trans }}
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-3 offset-3 text-right">
                                    {{ form_row(form.discount) }}
                                </div>
                            </div>

                            <div class="row mb-4">
                                <div class="col-6 pt-4" {{ stimulus_controller('billing-id') }}>
                                    <span {{ stimulus_target('billing-id', 'info') }}>
                                        <span class="h4">
                                            {{ 'Quote #'|trans }}<span {{ stimulus_target('billing-id', 'value') }}>{{ form.quoteId.vars.data }}</span>
                                        </span>
                                        {% if editQuoteId is not defined or editQuoteId is not same as(false) %}
                                            <a href="#" {{ stimulus_action('billing-id', 'edit') }}>{{ icon('pencil') }}</a>
                                        {% endif %}
                                    </span>

                                    <div class="d-none" {{ stimulus_target('billing-id', 'form') }}>

                                        {{ form_label(form.quoteId) }}
                                        <div class="input-group mb-3">
                                            {{ form_widget(form.quoteId) }}
                                            <div class="input-group-append">
                                                <button class="btn btn-outline-secondary" type="button" {{ stimulus_action('billing-id', 'save') }} title="{{ 'Save'|trans }}" rel="tooltip">
                                                    {{ icon('save') }}
                                                </button>
                                                <button class="btn btn-outline-secondary" type="button" {{ stimulus_action('billing-id', 'cancel') }} title="{{ 'Cancel'|trans }}" rel="tooltip">
                                                    {{ icon('cancel') }}
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row invoice-container">
                            <div class="col">
                                <div class="card">
                                    <div class="card-header">
                                        <h3 class="card-title"><strong>{{ 'quote.summary'|trans }}</strong></h3>
                                    </div>
                                    <div class="card-body">
                                        <div class="table-responsive">
                                            <table class="table table-condensed">
                                                <thead>
                                                <tr>
                                                    <th>
                                                        {{ "quote.item.heading.description"|trans }}
                                                    </th>
                                                    <th>
                                                        {{ "quote.item.heading.price"|trans }}
                                                    </th>
                                                    <th>
                                                        {{ "quote.item.heading.qty"|trans }}
                                                    </th>
                                                    {% if hasTax %}
                                                        <th>
                                                            {{ "quote.item.heading.tax"|trans }}
                                                        </th>
                                                    {% endif %}
                                                    <th class="text-right">{{ 'quote.item.heading.total'|trans }}</th>
                                                    <th></th>
                                                </tr>
                                                </thead>
                                                <tbody>
                                                    {% for index, item in form.lines %}
                                                <tr>
                                                    <td class="column-description">
                                                        {{ form_widget(item.description) }}
                                                        {{ form_errors(item.description) }}
                                                    </td>
                                                    <td class="column-price">
                                                        {{ form_widget(item.price) }}
                                                        {{ form_errors(item.price) }}
                                                    </td>
                                                    <td class="column-qty">
                                                        {{ form_widget(item.qty) }}
                                                        {{ form_errors(item.qty) }}
                                                    </td>
                                                    {% if hasTax %}
                                                        <td class="column-total text-right">
                                                            {{ form_widget(item.tax) }}
                                                            {{ form_errors(item.tax) }}
                                                        </td>
                                                    {% endif %}
                                                    <td class="column-total text-right">
                                                        {{ item.vars.value.total|formatCurrency(currency) }}
                                                    </td>
                                                    <td class="column-trash text-center">
                                                        {% if form.lines|length > 1 %}
                                                            {{ form_row(item.vars.button_delete, {label: ' ', attr: {class: 'remove-item text-danger fas fa-times-circle'}}) }}
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                                {% endfor %}
                                                </tbody>
                                                <tfoot>
                                                <tr>
                                                    <td colspan="{{ hasTax ? 4 : 3 }}" class="thick-line text-right"><strong>{{ 'billing.subtotal'|trans }}</strong></td>
                                                    <td class="thick-line text-right">
                                                        <div class="sub-total">
                                                            {{ quote.baseTotal|formatCurrency(currency) }}
                                                        </div>
                                                    </td>
                                                    <td class="thick-line">
                                                    </td>
                                                </tr>
                                                {% if hasTax %}
                                                    <tr>
                                                        <td colspan="{{ hasTax ? 4 : 3 }}" class="no-line text-right"><strong>{{ 'billing.tax'|trans }}</strong></td>
                                                        <td class="no-line text-right">
                                                        <span class="tax">
                                                            {{ quote.tax|formatCurrency(currency) }}
                                                        </span>
                                                        </td>
                                                        <td class="no-line">
                                                        </td>
                                                    </tr>
                                                {% endif %}
                                                <tr>
                                                    <td colspan="{{ hasTax ? 4 : 3 }}" class="no-line text-right"><strong>{{ 'billing.discount'|trans }}</strong></td>
                                                    <td class="no-line text-right">
                                                        <span class="text-danger discount">
                                                            {{ discount(quote)|formatCurrency(currency) }}
                                                        </span>
                                                    </td>
                                                    <td class="no-line">
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td colspan="{{ hasTax ? 4 : 3 }}" class="no-line text-right"><strong>{{ 'billing.total'|trans }}</strong></td>
                                                    <td class="no-line text-right">
                                                        <div class="total">
                                                            {{ quote.total|formatCurrency(currency) }}
                                                        </div>
                                                    </td>
                                                    <td class="no-line"></td>
                                                </tr>
                                                </tfoot>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col add-item-col">
                                {{ form_widget(form.lines.vars.button_add, {label: '+ Add Item', attr: {class: 'add-item'}}) }}
                            </div>
                        </div>


                        <br class="clear" />

                        <div class="row">
                            <div class="col-6">
                                {{ form_row(form.terms) }}
                            </div>
                            <div class="col-6">
                                {{ form_row(form.notes) }}
                            </div>
                        </div>

                        <div class="form-actions clearfix">
                            {% if isEdit %}
                            <div class="float-right">
                                <button type="submit" class="btn btn-info" name="save" value="save">
                                    {{ icon('check') }} {{ "Save Quote"|trans }}
                                </button>
                            </div>
                            {% else %}
                                <div class="float-left">
                                    <button type="submit" class="btn btn-success" name="save" value="pending">
                                        {{ icon('envelope', ['o']) }} {{ ("quote.save.send")|trans }}
                                    </button>
                                    <button type="submit" class="btn btn-info" name="save" value="publish">
                                        {{ icon('check') }} {{ "Save Quote"|trans }}
                                    </button>
                                </div>
                                <div class="float-right">
                                    <button type="submit" class="btn btn-primary" name="save" value="save">
                                        {{ icon('save') }} {{ "quote.save.draft"|trans }}
                                    </button>
                                </div>
                            {% endif %}
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock content %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Quote form debugging loaded');
            
            // Find the form
            const form = document.getElementById('quote-form');
            console.log('Form found:', form);
            console.log('Form action:', form ? form.action : 'NO FORM');
            console.log('Form method:', form ? form.method : 'NO FORM');
            
            // Add submit event listener
            if (form) {
                form.addEventListener('submit', function(e) {
                    console.log('=== FORM SUBMIT EVENT TRIGGERED ===');
                    console.log('Event:', e);
                    console.log('Form action:', form.action);
                    console.log('Form method:', form.method);
                    console.log('Form data:', new FormData(form));
                    
                    // Log all form data
                    const formData = new FormData(form);
                    console.log('Form data entries:');
                    for (let [key, value] of formData.entries()) {
                        console.log(`  ${key}: ${value}`);
                    }
                    
                    // Don't prevent default - let it submit
                    console.log('Allowing form to submit...');
                });
            }
            
            // Add click listeners to all save buttons
            const saveButtons = document.querySelectorAll('button[type="submit"]');
            console.log('Save buttons found:', saveButtons.length);
            
            saveButtons.forEach((button, index) => {
                console.log(`Button ${index}:`, button);
                console.log(`  Text: ${button.textContent.trim()}`);
                console.log(`  Name: ${button.name}`);
                console.log(`  Value: ${button.value}`);
                
                button.addEventListener('click', function(e) {
                    console.log(`=== BUTTON ${index} CLICKED ===`);
                    console.log('Button:', button);
                    console.log('Event:', e);
                    console.log('Button name:', button.name);
                    console.log('Button value:', button.value);
                });
            });
        });
    </script>
{% endblock %}