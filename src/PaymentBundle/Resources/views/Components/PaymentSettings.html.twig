<div {{ attributes }}>
    <div class="card">
        <div class="card-header with-border">
            <h3 class="card-title">
                {{ paymentMethod.name|default('Add New ' ~ this.method|humanize|title ~ ' Payment Method') }}
                {% if paymentMethod.gatewayName == 'bank_transfer' %}
                    <span style="color: red; font-size: 12px;">[DEBUG MODE ACTIVE]</span>
                {% endif %}
            </h3>
        </div>

        <div class="card-body">
            <div style="background: orange; padding: 10px; margin: 10px 0; border: 2px solid red;">
                <strong>PaymentSettings Debug:</strong><br>
                Gateway: "{{ paymentMethod.gatewayName }}"<br>
                Method param: "{{ this.method }}"<br>
                Factory: "{{ paymentMethod.factoryName }}"<br>
                Config (getConfig): {{ paymentMethod.config|json_encode }}<br>
                Config (raw): {{ attribute(paymentMethod, 'config')|json_encode }}<br>
                Form children: {{ form.children|keys|join(', ') }}<br>
                {% if form.config is defined %}
                Config form data: {{ form.config.vars.value|json_encode }}
                {% endif %}
            </div>
            {{ form_start(form, {
                attr: {
                    'data-action': 'live#action:prevent',
                    'data-live-action-param': 'save'
                }
            }) }}
                {{ form_widget(form) }}

                <div class="form-group">
                    <button data-loading="addAttribute(disabled)" type="submit" class="btn-success btn">
                        {{ icon('save') }} Save
                    </button>

                    {% if paymentMethod.id is not empty %}
                        <button data-loading="addAttribute(disabled)" type="button" class="btn-danger btn float-right" data-action="live#action" data-live-action-param="delete">
                            {{ icon('trash') }} Delete
                        </button>
                    {% endif %}
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
