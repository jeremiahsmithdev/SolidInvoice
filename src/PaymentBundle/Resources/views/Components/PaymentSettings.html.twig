<div {{ attributes }}>
    <div class="card">
        <div class="card-header with-border">
            <h3 class="card-title">
                {{ paymentMethod.name|default('Add New ' ~ this.method|humanize|title ~ ' Payment Method') }}
            </h3>
        </div>

        <div class="card-body">
            {% if paymentMethod.gatewayName == 'bank_transfer' %}
                {% if paymentMethod.config is not empty %}
                    <div class="alert alert-info">
                        <h5><i class="icon fas fa-university"></i> Current Bank Transfer Details</h5>
                        <div class="row">
                            <div class="col-md-6">
                                {% if paymentMethod.config.bank_name is defined %}
                                    <p><strong>Bank Name:</strong> {{ paymentMethod.config.bank_name }}</p>
                                {% endif %}
                                {% if paymentMethod.config.account_name is defined %}
                                    <p><strong>Account Name:</strong> {{ paymentMethod.config.account_name }}</p>
                                {% endif %}
                            </div>
                            <div class="col-md-6">
                                {% if paymentMethod.config.bsb is defined %}
                                    <p><strong>BSB:</strong> {{ paymentMethod.config.bsb }}</p>
                                {% endif %}
                                {% if paymentMethod.config.account_number is defined %}
                                    <p><strong>Account Number:</strong> {{ paymentMethod.config.account_number }}</p>
                                {% endif %}
                            </div>
                        </div>
                        {% if paymentMethod.config.reference_instructions is defined and paymentMethod.config.reference_instructions is not empty %}
                            <p><strong>Reference Instructions:</strong> {{ paymentMethod.config.reference_instructions }}</p>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="alert alert-warning">
                        <h5><i class="icon fas fa-exclamation-triangle"></i> Bank Transfer Not Configured</h5>
                        <p>Please fill in the bank transfer details below to enable this payment method.</p>
                    </div>
                {% endif %}
                
            {% endif %}
            {{ form_start(form, {
                attr: {
                    'data-action': 'live#action:prevent',
                    'data-live-action-param': 'save'
                }
            }) }}
                {{ form_widget(form) }}

                <div class="form-group">
                    <button data-loading="addAttribute(disabled)" type="submit" class="btn-success btn">
                        {{ icon('save') }} Save
                    </button>

                    {% if paymentMethod.id is not empty %}
                        <button data-loading="addAttribute(disabled)" type="button" class="btn-danger btn float-right" data-action="live#action" data-live-action-param="delete">
                            {{ icon('trash') }} Delete
                        </button>
                    {% endif %}
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
